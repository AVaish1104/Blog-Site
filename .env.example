# Copy to .env and adjust. Never commit .env.

# --- Core -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
# true for local development only
DJANGO_DEBUG=true
# Comma-separated host names the site is served on (required when DEBUG=false)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins for CSRF when behind HTTPS, e.g. https://blog.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Path of the built-in Django admin (superusers only). Leave blank to disable it.
DJANGO_ADMIN_PATH=django-admin/
# IANA time zone used to display and schedule posts
DJANGO_TIME_ZONE=UTC

# --- Publication ------------------------------------------------------------
SITE_NAME=Marginalia
SITE_TAGLINE=Essays, notes, and long reads.
# Absolute public URL, used in feeds, sitemaps and emails (no trailing slash)
SITE_URL=http://127.0.0.1:8000
SITE_LANGUAGE=en
# Set to false to close comments site-wide
COMMENTS_ENABLED=true

# --- Database ---------------------------------------------------------------
# Defaults to SQLite at data/db.sqlite3. For Postgres:
# DATABASE_URL=postgres://user:password@localhost:5432/blog
DATABASE_URL=

# --- Uploaded media ---------------------------------------------------------
# Local directory for uploads (must be on a persistent disk in production)
MEDIA_ROOT=
# Let Django serve uploaded files when DEBUG=false (single-server deployments).
# Prefer a reverse proxy or object storage for heavier traffic.
DJANGO_SERVE_MEDIA=false
# Optional S3-compatible storage (requires: pip install "django-storages[s3]")
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_REGION_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_CUSTOM_DOMAIN=

# --- Email (newsletter confirmations) ---------------------------------------
# With no EMAIL_HOST, emails are NOT sent: they are printed to the server log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Marginalia <newsletter@example.com>

# --- Production security ----------------------------------------------------
# Set when a proxy/load balancer terminates TLS and sets X-Forwarded-Proto
DJANGO_BEHIND_PROXY=false
# Trust the first X-Forwarded-For address for rate limiting (only behind a trusted proxy)
DJANGO_TRUST_X_FORWARDED_FOR=false
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=2592000
